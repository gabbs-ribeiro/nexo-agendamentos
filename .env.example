# Copie para .env.local (NUNCA commite o arquivo preenchido). Sem valores reais aqui.

# --- Front (Vite). So a chave anon/publishable. NUNCA service_role. ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON_OU_PUBLISHABLE
VITE_VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID

# --- Somente servidor Vercel (nao use prefixo VITE_ nem inclua em builds do front) ---
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=CHAVE_SERVICE_ROLE_SOMENTE_NO_SERVIDOR
# SUPABASE_WEBHOOK_SECRET=SEGREDO_COMPARTILHADO_COM_OS_WEBHOOKS_DO_SUPABASE
# VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID
# VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID
# VAPID_SUBJECT=mailto:seu-email@exemplo.com

# --- Somente testes locais contra o projeto de DEV (supabase/tests/concurrency_test.sh) ---
# SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
# SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON_DO_DEV
# N=30

# --- Somente backup manual na sua maquina (pg_dump). Contem senha: nunca no Git/Vercel. ---
